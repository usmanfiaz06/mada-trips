{
  "expo": {
    "name": "Mada Trips",
    "slug": "mada-trips",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "madatrips",
    "userInterfaceStyle": "light",
    "backgroundColor": "#e9e2d8",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "sa.madatrips.app",
      "associatedDomains": ["applinks:madatrips.sa"],
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "To read your passport. Nothing is uploaded until you check the details.",
        "NSFaceIDUsageDescription": "To open your Wallet."
      }
    },
    "android": {
      "package": "sa.madatrips.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e352d",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [{ "action": "VIEW", "autoVerify": true, "data": [{ "scheme": "https", "host": "madatrips.sa", "pathPrefix": "/join/" }], "category": ["BROWSABLE", "DEFAULT"] }]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#e9e2d8"
    },
    "plugins": [
      ["expo-contacts", { "contactsPermission": "To show who’s already on Mada. Numbers are matched on this phone and never stored." }],
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "To read your passport. Nothing is uploaded until you check the details."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "To open your Wallet."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e352d",
          "image": "./assets/images/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
