{
  "expo": {
    "name": "Mada Trips",
    "slug": "mada-trips",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "madatrips",
    "userInterfaceStyle": "light",
    "backgroundColor": "#e9e2d8",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "sa.madatrips.app",
      "associatedDomains": [
        "applinks:madatrips.sa"
      ],
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "To read your passport, and to take a photo of a document or your profile picture. Nothing is uploaded until you check it.",
        "NSPhotoLibraryUsageDescription": "To add a photo of a document or a profile picture you choose.",
        "NSFaceIDUsageDescription": "To open your Wallet and the app with Face ID.",
        "NSContactsUsageDescription": "To show who’s already on Mada. Numbers are matched on this phone and never stored.",
        "NSAlarmKitUsageDescription": "To wake you before a flight with an alarm that rings even on silent. Only when you turn it on.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "sa.madatrips.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e352d",
        "foregroundImage": "./assets/images/icon-foreground.png",
        "monochromeImage": "./assets/images/icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "madatrips.sa",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "madatrips.sa",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "madatrips.sa",
              "pathPrefix": "/trip/"
            },
            {
              "scheme": "https",
              "host": "madatrips.sa",
              "pathPrefix": "/plan/"
            },
            {
              "scheme": "https",
              "host": "madatrips.sa",
              "pathPrefix": "/city/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "com.android.alarm.permission.SET_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#e9e2d8"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "To show who’s already on Mada. Numbers are matched on this phone and never stored."
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "To read your passport, and to take a photo of a document or your profile picture. Nothing is uploaded until you check it.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To add a photo of a document or a profile picture you choose.",
          "cameraPermission": "To read your passport, and to take a photo of a document or your profile picture. Nothing is uploaded until you check it.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "To open your Wallet and the app with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e352d",
          "image": "./assets/images/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1e352d",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "en",
            "ar"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    }
  }
}
