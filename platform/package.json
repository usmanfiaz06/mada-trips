{
  "name": "mada-ops",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/copy-site.mjs && next dev -p 3100",
    "build": "node scripts/copy-site.mjs && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:bootstrap": "tsx src/db/seed.ts --bootstrap",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:deploy || echo \"WARNING: database setup failed (see error above). The site still deploys; open /adminwork/api/health to diagnose.\"; else echo \"Preview build ($VERCEL_ENV): skipping database migrations so unmerged changes never touch the live database.\"; fi; npm run build",
    "db:deploy": "npm run db:migrate && npm run db:bootstrap"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module"
}
