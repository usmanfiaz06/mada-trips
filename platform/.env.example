# Postgres connection (Supabase, Neon, RDS or local)
DATABASE_URL=postgres://mada:mada@localhost:5432/mada_ops

# Optional: secret mixed into the hash of website-lead senders' IPs (used only for the per-IP rate limit)
IP_HASH_SALT=

# ───────────── Mada Trips app: Core API (/api/app/v1) ─────────────
# Signs access tokens. 32+ characters. Required in production.  openssl rand -base64 48
APP_JWT_SECRET=
# Encrypts passport numbers (AES-256-GCM). base64 of 32 bytes.   openssl rand -base64 32
APP_DATA_KEY=
# After rotating APP_DATA_KEY, the old key(s) here, comma-separated, so old values still decrypt.
APP_DATA_KEYS_OLD=
# Keys the hashes of sign-in codes and IPs. Defaults to a value derived from APP_JWT_SECRET.
APP_OTP_PEPPER=
# mock (development default) or live (production default). Per supplier: SUPPLIER_MODE_SMS=live, etc.
# A production deployment refuses mock suppliers unless APP_ALLOW_MOCKS=yes. In mock SMS mode every code is 123456.
SUPPLIER_MODE=mock
# Live supplier credentials (see src/lib/app/suppliers/README.md)
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FLIGHTAWARE_API_KEY=
ANTHROPIC_API_KEY=
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# adsb.lol asks for contact details in the user agent (live aircraft positions are on by default).
ADSB_CONTACT=
