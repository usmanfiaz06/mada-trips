{
  "name": "@mada/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, zod schemas, money and date helpers, design tokens and the string catalogue shared by the Mada Trips app and its API. TypeScript source, no build step.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:copy": "node --experimental-strip-types scripts/lint-copy.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
