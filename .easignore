*.pyc
node_modules/
.expo/
dist-web/
*.log
.env
.env.local
apps/mobile/dist/
apps/mobile/web-build/
.vitest-pg/
*.tsbuildinfo

apps/mobile/src/theme/arabic-fonts.local.ts
apps/mobile/dist/
apps/mobile/.expo/
apps/mobile/expo-env.d.ts.bak
apps/mobile/ios/
apps/mobile/android/
apps/mobile/public/ocr/
